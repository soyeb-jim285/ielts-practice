<resources>
    <!-- Android 12+ system splash: the app's canvas colour and the pen-drawn NextBand symbol (drawable/splash_icon). -->
    <style name="Theme.IELTS" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:windowSplashScreenBackground">@color/window_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenAnimationDuration">1000</item>
    </style>
</resources>
