# Self-hosted LiveKit server credentials, NOT LiveKit Cloud inference credentials.
LIVEKIT_URL=wss://livekit.example.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=ielts-examiner
OPENROUTER_API_KEY=
SONIOX_API_KEY=
# Optional direct providers. The worker passes this repo key explicitly to the SDK.
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=
INWORLD_API_KEY=
GRADIUM_API_KEY=
# Required only when selecting a non-Soniox TTS. Set your actual plan rate.
# Do not set zero unless your provider contract genuinely charges zero.
# ELEVENLABS_USD_PER_M_CHARS=20
# CARTESIA_USD_PER_M_CHARS=
# INWORLD_USD_PER_M_CHARS=
# GRADIUM_USD_PER_M_CHARS=
OTEL_SDK_DISABLED=true
