NODE_ENV=development
PORT=8787
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://postgres:ielts@localhost:5433/ielts
BETTER_AUTH_SECRET=generate-with-openssl-rand-hex-32
BETTER_AUTH_URL=http://localhost:8787
# The shared "community" key: put a spend limit on it at openrouter.ai/settings/keys (e.g. $20). Its remaining balance is shown to everyone. See docs/community.md
OPENROUTER_API_KEY=
# Live examiner (docs/live-examiner.md): ordinary users bring their OWN OpenAI/Gemini key (Settings); these server keys are used only for the owner (CAMBRIDGE_ALLOWED_EMAILS).
OPENAI_API_KEY=
# OPENAI_LIVE_MODEL=gpt-live-1
# OPENAI_LIVE_VOICE=vesper
GEMINI_API_KEY=
# GEMINI_LIVE_MODEL=gemini-3.8-live
# Optional: ElevenLabs Scribe v2 speech-to-text (default stt when set; falls back to Whisper via OpenRouter)
ELEVENLABS_API_KEY=
# Optional: our verbatim Whisper on Modal (admin transcription playground). Modal dashboard > Settings > Proxy Auth Tokens
MODAL_KEY=
MODAL_SECRET=
# MODAL_ASR_URL=https://soyeb-jim--verbatim-asr-asr-web.modal.run
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ielts-practice
RESEND_API_KEY=
EMAIL_FROM=NextBand <noreply@example.com>
CAMBRIDGE_ALLOWED_EMAILS=soyebjim@gmail.com

# LiveKit optional TTS: actual plan USD per million characters; required when selected.
# Free credits are not a zero marginal-cost rate. Soniox uses its published audio rate.
ELEVENLABS_USD_PER_M_CHARS=
CARTESIA_USD_PER_M_CHARS=
INWORLD_USD_PER_M_CHARS=
GRADIUM_USD_PER_M_CHARS=

# --- Community mode (docs/community.md) ---
# Encrypts users' own API keys at rest (AES-256-GCM). REQUIRED in production (without it saving keys returns 503). Generate: openssl rand -hex 32. Keep it separate from BETTER_AUTH_SECRET; changing it makes saved keys unreadable.
KEY_ENCRYPTION_SECRET=
# Community tests are blocked when the shared OpenRouter key has less than this many USD left (default 0.25)
# COMMUNITY_MIN_BALANCE=0.25
# Max community-paid tests per rolling hour across all users (default 60); above it people see a friendly "busy" message
# COMMUNITY_MAX_PER_HOUR=60
# Guests: max tests per skill per client IP per week across all anonymous users (default 3; each anonymous user is also capped at 1)
# GUEST_IP_WEEKLY_CAP=3
# Salt for hashing client IPs (never stored raw). Default: derived from BETTER_AUTH_SECRET. Generate: openssl rand -hex 32
# IP_HASH_SALT=
# Optional: Soniox real-time speech-to-text for the fast cascade examiner (admin playground)
SONIOX_API_KEY=

# --- LiveKit examiner (admin-only playground; docs/livekit.md) ---
# Keep unset to leave this optional engine disabled. Public signaling URL for the
# API/browser; the standalone worker overrides this with its loopback URL.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=ielts-examiner
# Generate independently: openssl rand -hex 32 (at least 32 characters).
LIVEKIT_REPORT_SECRET=
# DNS-only hostname pointing directly at the media VPS, never Cloudflare proxy.
LIVEKIT_TURN_DOMAIN=
# Optional immutable CI image tag; default latest. Production: use a commit SHA.
# LIVEKIT_WORKER_TAG=
# Soniox + OPENROUTER_API_KEY above are the default cascade credentials.
# Alternative TTS providers; ElevenLabs above also supports optional live STT.
CARTESIA_API_KEY=
INWORLD_API_KEY=
GRADIUM_API_KEY=
