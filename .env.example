NODE_ENV=development
PORT=8787
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://postgres:ielts@localhost:5433/ielts
BETTER_AUTH_SECRET=generate-with-openssl-rand-hex-32
BETTER_AUTH_URL=http://localhost:8787
# The shared "community" key: put a spend limit on it at openrouter.ai/settings/keys (e.g. $20). Its remaining balance is shown to everyone. See docs/community.md
OPENROUTER_API_KEY=
# Live examiner (docs/live-examiner.md): ordinary users bring their OWN OpenAI/Gemini key (Settings); these server keys are used only for the owner (CAMBRIDGE_ALLOWED_EMAILS).
OPENAI_API_KEY=
# OPENAI_LIVE_MODEL=gpt-live-1
# OPENAI_LIVE_VOICE=vesper
GEMINI_API_KEY=
# GEMINI_LIVE_MODEL=gemini-3.8-live
# Optional: ElevenLabs Scribe v2 speech-to-text (default stt when set; falls back to Whisper via OpenRouter)
ELEVENLABS_API_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ielts-practice
RESEND_API_KEY=
EMAIL_FROM=IELTS Practice <noreply@example.com>
CAMBRIDGE_ALLOWED_EMAILS=soyebjim@gmail.com

# --- Community mode (docs/community.md) ---
# Encrypts users' own API keys at rest (AES-256-GCM). REQUIRED in production (without it saving keys returns 503). Generate: openssl rand -hex 32. Keep it separate from BETTER_AUTH_SECRET; changing it makes saved keys unreadable.
KEY_ENCRYPTION_SECRET=
# Community tests are blocked when the shared OpenRouter key has less than this many USD left (default 0.25)
# COMMUNITY_MIN_BALANCE=0.25
# Max community-paid tests per rolling hour across all users (default 60); above it people see a friendly "busy" message
# COMMUNITY_MAX_PER_HOUR=60
# Guests: max tests per skill per client IP per week across all anonymous users (default 3; each anonymous user is also capped at 1)
# GUEST_IP_WEEKLY_CAP=3
# Salt for hashing client IPs (never stored raw). Default: derived from BETTER_AUTH_SECRET. Generate: openssl rand -hex 32
# IP_HASH_SALT=
